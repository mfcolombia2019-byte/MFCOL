diff --git a/tests/catalog-sync.test.mjs b/tests/catalog-sync.test.mjs
new file mode 100644
index 0000000..0b943c3
--- /dev/null
+++ b/tests/catalog-sync.test.mjs
@@ -0,0 +1,33 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import { validateCart } from "../netlify/functions/_catalog.mjs";
+import { toPublicProduct } from "../netlify/functions/_admin-data.mjs";
+
+const rec = { id: "producto-nuevo-prueba", source: "panel", status: "activo", name: "Producto nuevo", price: 150000, cost: 77777,
+  imgs: [{ path: "assets/x.jpg", alt: "x" }], colors: ["Negro"], sizes: ["36", "37"], category: "Sandalias", collection: "tacones", order: 1 };
+const extra = [toPublicProduct(rec)];
+
+test("producto del panel activo se valida con su precio del servidor", () => {
+  const c = validateCart([{ id: rec.id, qty: 1, size: "36", color: "Negro", unitPrice: 1 }], extra);
+  assert.equal(c.items[0].unitPrice, 150000);
+  assert.equal(c.subtotal, 150000);
+});
+test("sin extras el producto del panel no existe (comportamiento actual)", () => {
+  assert.throws(() => validateCart([{ id: rec.id, qty: 1, size: "36", color: "Negro" }]), /no disponible/);
+});
+test("talla no ofrecida por el producto del panel se rechaza", () => {
+  assert.throws(() => validateCart([{ id: rec.id, qty: 1, size: "40", color: "Negro" }], extra), /Talla no disponible/);
+});
+test("inactivo o archivado no se acepta", () => {
+  assert.equal(toPublicProduct({ ...rec, status: "inactivo" }), null);
+  assert.equal(toPublicProduct({ ...rec, status: "archivado" }), null);
+});
+test("el catálogo estático gana ante un id repetido", () => {
+  const base = "mule-de-tacon-alto-con-tres-tiras";
+  const c = validateCart([{ id: base, qty: 1, size: "36", color: "Negro" }], [{ id: base, name: "x", price: 1, colors: [], sizes: ["36"] }]);
+  assert.equal(c.items[0].unitPrice, 189900);
+});
+test("el producto público no expone costo, notas ni historial", () => {
+  const j = JSON.stringify(toPublicProduct({ ...rec, notes: "interno", history: [1] }));
+  assert.ok(!/cost|notes|history|77777/.test(j));
+});
